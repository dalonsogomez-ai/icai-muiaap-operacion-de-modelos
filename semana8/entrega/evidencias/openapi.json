{
  "openapi": "3.1.0",
  "info": {
    "title": "Practica 8 - Chatbot de riesgo",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Predict",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrestamoEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrediccionSalida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSalida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatEntrada": {
        "properties": {
          "mensajes": {
            "items": {
              "$ref": "#/components/schemas/Mensaje"
            },
            "type": "array",
            "minItems": 1,
            "title": "Mensajes"
          }
        },
        "type": "object",
        "required": [
          "mensajes"
        ],
        "title": "ChatEntrada"
      },
      "ChatSalida": {
        "properties": {
          "respuesta": {
            "type": "string",
            "title": "Respuesta"
          },
          "herramienta": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HerramientaUsada"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "respuesta"
        ],
        "title": "ChatSalida"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HerramientaUsada": {
        "properties": {
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "argumentos": {
            "additionalProperties": true,
            "type": "object",
            "title": "Argumentos"
          },
          "resultado": {
            "additionalProperties": true,
            "type": "object",
            "title": "Resultado"
          }
        },
        "type": "object",
        "required": [
          "nombre",
          "argumentos",
          "resultado"
        ],
        "title": "HerramientaUsada"
      },
      "Mensaje": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Mensaje"
      },
      "PrediccionSalida": {
        "properties": {
          "probabilidad_impago": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probabilidad Impago"
          },
          "decision": {
            "type": "string",
            "enum": [
              "aprobar",
              "revisar",
              "rechazar"
            ],
            "title": "Decision"
          }
        },
        "type": "object",
        "required": [
          "probabilidad_impago",
          "decision"
        ],
        "title": "PrediccionSalida"
      },
      "PrestamoEntrada": {
        "properties": {
          "edad": {
            "type": "integer",
            "maximum": 75.0,
            "minimum": 18.0,
            "title": "Edad"
          },
          "ingresos_mensuales": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Ingresos Mensuales"
          },
          "importe_prestamo": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Importe Prestamo"
          },
          "plazo_meses": {
            "type": "integer",
            "maximum": 84.0,
            "minimum": 6.0,
            "title": "Plazo Meses"
          },
          "antiguedad_laboral_anios": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Antiguedad Laboral Anios",
            "description": "No puede superar edad - 16 años."
          },
          "impagos_previos": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Impagos Previos"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "edad",
          "ingresos_mensuales",
          "importe_prestamo",
          "plazo_meses",
          "antiguedad_laboral_anios",
          "impagos_previos"
        ],
        "title": "PrestamoEntrada"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
